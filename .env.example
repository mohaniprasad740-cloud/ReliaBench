# ==========================================
# RELIABENCH ENVIRONMENT CONFIGURATION
# ==========================================

# Core Application Settings
PROJECT_NAME=Reliabench
API_V1_PREFIX=/api/v1
ENVIRONMENT=production

# Database Configuration
# Local Development: SQLite
DATABASE_URL=sqlite:///./reliabench.db
# Production (Neon / Supabase PostgreSQL):
# DATABASE_URL=postgresql://user:password@ep-cool-sample.us-east-2.aws.neon.tech/reliabench?sslmode=require

# Artifact Storage Configuration
# Options: 'local' (development) or 'vercel_blob' (production durable cloud storage)
STORAGE_PROVIDER=local
# Required if STORAGE_PROVIDER=vercel_blob:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Model Gateway Integration (Bifrost)
ENABLE_BIFROST_GATEWAY=false
BIFROST_ENDPOINT=http://localhost:8080/v1

# Harbor CLI Sandbox Execution Engine
HARBOR_VERSION_REQUIRED=v0.25.0
HARBOR_BIN_PATH=harbor

# Execution Plane Remote Worker (Optional for long-running Docker executions)
# EXECUTION_WORKER_URL=https://worker.your-domain.com
# EXECUTION_WORKER_SECRET=your_worker_shared_token
